    '<div class=\"fgrid\"><label class=\"fld\"><span class=\"mut small\">Ngày nhắc</span><input id=\"rmd\" type=\"date\" value=\"' + esc(l.next || '') + '\"></label><label class=\"fld\"><span class=\"mut small\">Việc cần làm</span><input id=\"rmn\" placeholder=\"Ví dụ: gọi gửi bảng giá\"></label></div>' +\n    '<div class=\"row\"><button class=\"btn p\" id=\"rmok\">Đặt lịch nhắc</button>' + (l.next ? '<button class=\"btn\" id=\"rmclr\">Xoá lịch hiện tại</button>' : '') + '</div></div>';\n}\nfunction openLead(phone, page, keep) {\n  var l = D.leads.filter(function (x) { return x.phone === phone; })[0]; if (!l) return;\n  if (page === undefined) page = narrow();\n  if (page && !V.phone) { V.from = tab; V.y = window.scrollY; }\n  var sel = function (id, arr, v, first) { return '<select id=\"' + id + '\"><option value=\"\">' + first + '</option>' + arr.map(function (s) { return '<option' + (s === v ? ' selected' : '') + '>' + esc(s) + '</option>'; }).join('') + '</select>'; };\n  var lab = function (t, h) { return '<label class=\"fld\"><span class=\"mut small\">' + t + '</span>' + h + '</label>'; };\n  var inp = function (id, v, ph, ty) { return '<input id=\"' + id + '\"' + (ty ? ' type=\"' + ty + '\"' : '') + ' value=\"' + esc(v) + '\"' + (ph ? ' placeholder=\"' + esc(ph) + '\"' : '') + '>'; };\n  var srcLine = [l.srcType, l.source, l.campaign].filter(Boolean).join(' · ') || 'Chưa rõ';\n  var P = {\n    h2: '<h2 style=\"margin:0\">KH' + pad(l.id) + ' · ' + esc(l.name || '(chưa có tên)') + ' · ' + esc(l.phone) + ' ' + zl(l.phone, l) + '</h2><p class=\"mut small\">' + esc(l.site) + ' · ' + esc(l.email) + ' · gửi form ' + l.submits + ' lần · nhận lúc ' + esc(fmt(l.at)) + '</p>',\n    actions: '<div class=\"row\"><button class=\"btn z\" data-a=\"zalo\">Nhắn Zalo</button><button class=\"btn g\" data-a=\"call\">Gọi</button><button class=\"btn\" data-a=\"sms\">Đã nhắn SMS</button>' + (aiOn() ? '<button class=\"btn\" id=\"zcBtn\">Chụp Zalo gửi lên</button>' : '') + (aiOn() ? '<button class=\"btn\" id=\"aiBtn\">AI phân tích khách hàng</button>' : '') + '</div>' +\n    '<div id=\"aiOut\" class=\"card\" hidden></div>',\n    personal: '<h3>Thông tin cá nhân <span class=\"tag\">Khách cung cấp</span></h3><div class=\"fgrid\">' +\n    lab('Họ và tên', inp('nm', l.name)) + lab('Link Drive / hồ sơ khách', inp('du', l.docUrl)) + lab('SĐT phụ', inp('p2', l.phone2)) + lab('Zalo', sel('zl', ['Đã kết nối', 'Chưa xác nhận', 'Không dùng Zalo'], l.zalo, 'Chưa cập nhật')) +\n    lab('Tỉnh/thành phố', inp('pv', l.province, 'Hà Nội, Hải Phòng, Đà Nẵng…')) + lab('Quận/huyện, phường/xã', inp('dt', l.district)) + lab('Địa chỉ chi tiết (số nhà, đường)', inp('ad2', l.address)) + lab('Ngày sinh', inp('db', l.dob, '', 'date')) + lab('Nghề nghiệp', inp('jb', l.job)) + '</div>',\n    source: '<h3>Nguồn khách <span class=\"tag\">Tự ghi nhận, không sửa</span></h3><div class=\"meta small\"><span><span class=\"mut\">Nguồn đầu tiên:</span> ' + esc(srcLine) + '</span><span><span class=\"mut\">Phát sinh:</span> ' + esc(fmt(l.at)) + '</span><span><span class=\"mut\">Website:</span> ' + esc(l.site) + '</span><span><span class=\"mut\">Trang lead:</span> ' + esc(l.leadUrl || 'Chưa cập nhật') + '</span></div>',\n    needs: '<h3>Nhu cầu và tài chính <span class=\"tag\">Khách cung cấp</span></h3><div class=\"fgrid\">' +\n    lab('Dự án quan tâm', '<input id=\"pj\" list=\"vpl\" value=\"' + esc(l.project) + '\" placeholder=\"Ví dụ: Sun FourS Tower\">') + lab('Mục đích mua', sel('pp', ['Ở thực', 'Đầu tư', 'Cho thuê', 'Kinh doanh'], l.purpose, 'Chưa rõ')) + lab('Loại căn', inp('pd', l.product, 'Ví dụ: 2PN, 80m2')) +\n    lab('Ngân sách tối thiểu', inp('b1', l.bmin, 'Ví dụ: 2 tỷ')) + lab('Ngân sách tối đa', inp('b2', l.bmax, 'Ví dụ: 3 tỷ')) + lab('Vốn tự có', inp('eq', l.equity, 'Ví dụ: 1 tỷ')) +\n    lab('Vay ngân hàng', sel('ln', ['Có', 'Không', 'Chưa rõ'], l.loan, 'Chưa hỏi')) + lab('Khoản vay dự kiến', inp('la', l.loanAmt)) + lab('Thời điểm dự kiến mua', inp('bt', l.buyTime, 'Ví dụ: Quý 1/2027')) + '</div>' +\n    lab('Lý do chưa quyết định', '<textarea id=\"ud\" rows=\"2\">' + esc(l.undecided) + '</textarea>'),\n    manage: '<h3>Quản lý <span class=\"tag\">Đánh giá của bạn</span></h3><div class=\"fgrid\">' +\n    lab('Trạng thái', '<select id=\"st\">' + STATUS.map(function (s) { return '<option' + (s === l.status ? ' selected' : '') + '>' + s + '</option>'; }).join('') + '</select>') + lab('Lý do đổi trạng thái (nếu có)', inp('sr', '', 'Bắt buộc ghi khi chọn Mất hoặc Tạm dừng')) +\n    lab('Sale phụ trách', sel('as', saleNames([l.assignee].filter(Boolean)), l.assignee, 'Chưa giao')) + lab('Lý do chuyển sale', inp('rs', '', 'Ví dụ: sale cũ nghỉ')) +\n    lab('Hẹn tiếp theo', inp('nx', l.next, '', 'date')) + lab('Mức tiềm năng', sel('ht', ['Nóng', 'Ấm', 'Lạnh'], l.heat, 'Chưa đánh giá')) + lab('Giá trị chốt (VNĐ)', inp('vl', l.value || '', '', 'number')) + '</div>' +\n    '<textarea id=\"nt\" rows=\"2\" placeholder=\"Ghi chú chung\">' + esc(l.note) + '</textarea><div class=\"row\" style=\"margin-top:8px\"><button class=\"btn p\" id=\"sv\">Lưu thông tin</button><button class=\"btn\" id=\"cl\">Đóng</button></div>',\n    care: '<h3>Lịch sử chăm sóc' + (aiOn() ? ' <button class=\"btn sm\" id=\"zcBtn2\">Chụp Zalo gửi lên</button>' : '') + '</h3><div class=\"fgrid\">' + lab('Hình thức', '<select id=\"lt\">' + ['Gọi điện', 'Nhắn Zalo', 'Gặp mặt', 'Gửi tài liệu', 'Ghi chú', 'Khác'].map(function (s) { return '<option>' + s + '</option>'; }).join('') + '</select>') +\n    lab('Kết quả', sel('lq', LOG_RES, '', 'Chọn kết quả')) + lab('Tài liệu đã gửi', inp('ld', '')) + lab('Hẹn liên hệ lại', inp('ln2', '', '', 'date')) + '</div>' +\n    '<textarea id=\"lc\" rows=\"2\" placeholder=\"Nội dung trao đổi\"></textarea><div class=\"fgrid\" style=\"margin-top:6px\">' + lab('Phản hồi của khách', inp('lp', '')) + lab('Vướng mắc của khách', inp('lo', '')) + lab('Hành động tiếp theo', inp('la2', '')) + '</div>' +\n    '<div class=\"row\" style=\"margin-top:8px\"><button class=\"btn p\" id=\"la\">Thêm lần chăm sóc</button></div><ul class=\"tl\" id=\"lg\"><li class=\"mut\">Đang tải…</li></ul>',\n    views: '<h3>Dự án đã xem</h3><div class=\"fgrid\">' + lab('Dự án', '<input id=\"vp\" list=\"vpl\" placeholder=\"Tên dự án\">') + lab('Ngày xem', inp('vd', ymdNow(0), '', 'date')) + lab('Hình thức', sel('vf', ['Trực tiếp', 'Tham dự sự kiện', 'Trực tuyến'], 'Trực tiếp', 'Chọn')) +\n    lab('Sản phẩm quan tâm', inp('vs', '')) + lab('Người đi cùng', inp('vc', '')) + lab('Mức quan tâm', sel('vi', ['Cao', 'Trung bình', 'Thấp'], '', 'Chưa đánh giá')) + '</div>' +\n    '<datalist id=\"vpl\">' + D.sites.map(function (s) { return '<option value=\"' + esc(s.name) + '\">'; }).join('') + '</datalist>' +\n    '<div class=\"fgrid\">' + lab('Nhận xét của khách sau khi xem', inp('vk', '')) + lab('Ưu điểm khách đánh giá cao', inp('vr', '')) + lab('Vướng mắc / lý do chưa quyết định', inp('vo', '')) + lab('Bước tiếp theo', inp('vn', '')) +\n    lab('Lịch chăm sóc sau khi xem (gợi ý: 2 ngày sau, bạn sửa được)', inp('vx', ymdNow(2), '', 'date')) + '</div>' +\n    '<label class=\"chk\"><input type=\"checkbox\" id=\"vst\"> Đổi trạng thái khách sang \"Đã xem dự án\"</label>' +\n    '<div class=\"row\" style=\"margin-top:8px\"><button class=\"btn p\" id=\"va\">Ghi nhận lần xem</button></div><ul class=\"tl\" id=\"vw\"><li class=\"mut\">Đang tải…</li></ul>',\n    access: '<h3>Lịch sử truy cập và các lần để lại thông tin</h3><ul class=\"tl\" id=\"tl\"><li class=\"mut\">Đang tải…</li></ul>'\n  };\n  var body = pageSummary(l) + remindBox(l) +\n    '<div class=\"card\">' + P.actions + '</div>' + '<div class=\"card\">' + foldForm(P.care, 'lg', 'Lịch sử chăm sóc', '+ Thêm lần chăm sóc') + '</div><div class=\"card\">' + foldForm(P.views, 'vw', 'Dự án đã xem', '+ Ghi nhận lần xem dự án') + '</div>' +\n    '<details class=\"card sec\" id=\"editsec\"><summary>Chỉnh sửa thông tin khách</summary>' + P.personal + P.needs + P.manage + '</details><div class=\"card\">' + P.source + P.access + '</div>';\n  if (page) {\n    V.phone = phone; window.scrollTo(0, keep || 0);\n    $('#main').innerHTML = '<div class=\"pgbar\"><button class=\"btn\" id=\"back\">‹ Danh sách</button><b class=\"pgname\">' + esc(l.name || l.phone) + '</b></div>' + body;\n  } else {\n    $('#dlgBody').innerHTML = '<div class=\"pgbar\"><b class=\"pgname\">KH' + pad(l.id) + ' · ' + esc(l.name || l.phone) + '</b><span class=\"sp\"></span><button class=\"btn\" id=\"back\">Đóng</button></div>' + body;\n    if (!$('#dlg').open) $('#dlg').showModal();\n  }\n  var fin = function () { if (page) openLead(phone, true, window.scrollY); else openLead(phone, false); };\n  if ($('#back')) $('#back').onclick = function () { if (page) backToList(); else $('#dlg').close(); };\n  if ($('#cl')) $('#cl').onclick = function () { if (page) backToList(); else $('#dlg').close(); };\n  document.querySelectorAll('#main [data-a], #dlgBody [data-a]').forEach(function (b) { b.onclick = function () {\n    var a = b.dataset.a; if (a === 'zalo') window.open('https://zalo.me/' + phone, '_blank', 'noopener'); if (a === 'call') window.open('tel:' + phone, '_self');\n    run('crmLog', phone, a).then(function (r) { l.called = r.called; l.messaged = r.messaged; l.contactedAt = r.contactedAt; l.status = r.status; badges(); toast('Đã ghi nhận'); fin(); }).catch(fail); }; });\n  $('#sv').onclick = function () {\n    var st = $('#st').value;\n    if ((st === 'Mất' || st === 'Tạm dừng') && st !== l.status && !$('#sr').value.trim()) { toast('Hãy ghi lý do khi chuyển sang ' + st); $('#sr').focus(); return; }\n    var f = { docUrl: $('#du').value, name: $('#nm').value, phone2: $('#p2').value, zalo: $('#zl').value, province: $('#pv').value, district: $('#dt').value, address: $('#ad2').value, dob: $('#db').value, job: $('#jb').value,\n      project: $('#pj').value, purpose: $('#pp').value, product: $('#pd').value, bmin: $('#b1').value, bmax: $('#b2').value, equity: $('#eq').value, loan: $('#ln').value, loanAmt: $('#la').value, buyTime: $('#bt').value, undecided: $('#ud').value,\n      status: st, statusReason: $('#sr').value, assignee: $('#as').value, reason: $('#rs').value, next: $('#nx').value, heat: $('#ht').value, value: $('#vl').value, note: $('#nt').value };\n    run('crmUpdateLead', phone, f).then(function () {\n      ['name', 'phone2', 'zalo', 'province', 'district', 'address', 'dob', 'job', 'project', 'purpose', 'product', 'bmin', 'bmax', 'equity', 'loan', 'loanAmt', 'buyTime', 'undecided', 'status', 'assignee', 'next', 'heat', 'note'].forEach(function (k) { l[k] = f[k]; });\n      l.value = Number(f.value) || 0; l.budget = f.bmin && f.bmax ? f.bmin + ' – ' + f.bmax : (f.bmin || f.bmax || l.budget);\n      badges(); fin(); toast('Đã lưu');\n    }).catch(fail);\n  };\n  var loadHist = function () {\n    run('crmLogs', phone).then(function (r) {\n      var manual = r.logs.filter(function (x) { return !/^Đổi trạng thái/.test(x.content); }).slice().reverse(), numOf = {};\n      manual.forEach(function (x, i) { numOf[x.at + x.content] = i + 1; });\n      var items = r.logs.map(function (x) {\n        var n = numOf[x.at + x.content];\n        return { at: x.at, h: (n ? '<span class=\"tag blu\">Lần ' + n + '</span> ' : '') + '<b>' + esc(x.type) + '</b>' + (x.by ? ' · ' + esc(x.by) : '') + (x.result ? ' · <span class=\"tag amb\">' + esc(x.result) + '</span>' : '') + '<div class=\"small\">' + esc(x.content) + '</div>' +\n          (x.reply ? '<div class=\"small\">Khách phản hồi: ' + esc(x.reply) + '</div>' : '') + (x.obstacle ? '<div class=\"small\">Vướng mắc: ' + esc(x.obstacle) + '</div>' : '') + (x.docs ? '<div class=\"small\">Tài liệu đã gửi: ' + esc(x.docs) + '</div>' : '') +\n          (x.nextAction ? '<div class=\"small\">Hành động tiếp theo: ' + esc(x.nextAction) + '</div>' : '') + (x.next ? '<div class=\"small mut\">Hẹn liên hệ lại: ' + esc(fdmy(x.next)) + '</div>' : '') };\n      }).concat(r.moves.map(function (x) { return { at: x.at, h: '<b>Chuyển giao</b> · ' + esc(x.from || 'chưa giao') + ' sang ' + esc(x.to || 'chưa giao') + (x.reason ? '<div class=\"small\">Lý do: ' + esc(x.reason) + '</div>' : '') + '<div class=\"small mut\">Trạng thái lúc chuyển: ' + esc(x.status) + '</div>' }; }));\n      items.sort(function (p, q) { return new Date(q.at) - new Date(p.at); });\n      $('#lg').innerHTML = items.map(function (x) { return '<li><span class=\"mut\">' + esc(fmt(x.at)) + '</span> ' + x.h + '</li>'; }).join('') || '<li class=\"mut\">Chưa có lần chăm sóc nào. Ghi lại mỗi lần gọi hoặc nhắn để lần sau nhìn là hiểu khách đang ở đâu.</li>';\n      if ($('#lastReply')) { var lr = r.logs.filter(function (x) { return x.reply; })[0]; $('#lastReply').textContent = lr ? lr.reply + ' (' + fdmy(lr.at.slice(0, 10)) + ')' : 'Chưa ghi nhận'; }\n      $('#vw').innerHTML = r.views.map(function (x) { return '<li><span class=\"mut\">' + esc(fdmy(x.at)) + '</span> <b>' + esc(x.project) + '</b> · ' + esc(x.form) + (x.interest ? ' · <span class=\"tag amb\">Quan tâm ' + esc(x.interest) + '</span>' : '') +\n        (x.product ? '<div class=\"small\">Sản phẩm: ' + esc(x.product) + '</div>' : '') + (x.companions ? '<div class=\"small\">Đi cùng: ' + esc(x.companions) + '</div>' : '') + (x.feedback ? '<div class=\"small\">Nhận xét: ' + esc(x.feedback) + '</div>' : '') +\n        (x.pros ? '<div class=\"small\">Ưu điểm: ' + esc(x.pros) + '</div>' : '') + (x.obstacle ? '<div class=\"small\">Vướng mắc: ' + esc(x.obstacle) + '</div>' : '') + (x.nextStep ? '<div class=\"small\">Bước tiếp theo: ' + esc(x.nextStep) + '</div>' : '') + (x.next ? '<div class=\"small mut\">Chăm sóc sau xem: ' + esc(fdmy(x.next)) + '</div>' : '') + '</li>'; }).join('') || '<li class=\"mut\">Chưa đi xem dự án nào.</li>';\n    }).catch(function () { $('#lg').innerHTML = '<li class=\"mut\">Không tải được lịch sử</li>'; $('#vw').innerHTML = ''; });\n  };\n  {\n    document.querySelectorAll('[data-rm]').forEach(function (b) { b.onclick = function () { $('#rmd').value = ymdNow(Number(b.dataset.rm)); }; });\n    $('#rmok').onclick = function () {\n      var d = $('#rmd').value; if (!d) { toast('Chọn ngày nhắc'); return; }\n      var n = $('#rmn').value.trim();\n      run('crmAddLog', phone, { type: 'Ghi chú', content: 'Nhắc việc: ' + (n || 'liên hệ lại khách'), next: d }).then(function () { l.next = d; l.careCount = (l.careCount || 0) + 1; l.careAt = new Date().toISOString(); badges(); toast('Đã đặt lịch nhắc ' + dmy(d)); fin(); }).catch(fail);\n    };\n    if ($('#rmclr')) $('#rmclr').onclick = function () { run('crmUpdateLead', phone, { next: '' }).then(function () { l.next = ''; badges(); toast('Đã xoá lịch'); fin(); }).catch(fail); };\n    document.querySelectorAll('#main [data-act], #dlgBody [data-act]').forEach(function (b) { b.onclick = function () {\n      if (b.dataset.act === 'zalo') window.open('https://zalo.me/' + phone, '_blank', 'noopener'); else window.open('tel:' + phone, '_self');\n      run('crmLog', phone, b.dataset.act).then(function (r) { l.called = r.called; l.messaged = r.messaged; l.contactedAt = r.contactedAt; l.status = r.status; badges(); toast('Đã ghi nhận'); fin(); }).catch(fail); }; });\n  }\n  loadHist();\n  $('#la').onclick = function () {\n    var f = { type: $('#lt').value, result: $('#lq').value, content: $('#lc').value, reply: $('#lp').value, obstacle: $('#lo').value, docs: $('#ld').value, nextAction: $('#la2').value, next: $('#ln2').value || undefined };\n    run('crmAddLog', phone, f).then(function () {\n      if (f.next) l.next = f.next; l.careCount = (l.careCount || 0) + 1; l.careAt = new Date().toISOString(); l.careResult = f.result || l.careResult;\n      ['lc', 'lp', 'lo', 'ld', 'la2', 'ln2'].forEach(function (id) { $('#' + id).value = ''; }); $('#lq').value = ''; toast('Đã ghi lần chăm sóc'); badges(); if (page) fin(); else loadHist();\n    }).catch(fail);\n  };\n  $('#va').onclick = function () {\n    var f = { project: $('#vp').value, at: $('#vd').value, form: $('#vf').value, product: $('#vs').value, companions: $('#vc').value, interest: $('#vi').value, feedback: $('#vk').value, pros: $('#vr').value, obstacle: $('#vo').value, nextStep: $('#vn').value, next: $('#vx').value };\n    run('crmAddView', phone, f).then(function () {\n      l.viewCount = (l.viewCount || 0) + 1; if (!l.viewAt || f.at >= l.viewAt) { l.viewAt = f.at; l.viewProject = f.project; } if (f.next) l.next = f.next;\n      var done = function () { badges(); toast('Đã ghi nhận lần xem dự án'); ['vp', 'vs', 'vc', 'vk', 'vr', 'vo', 'vn'].forEach(function (id) { $('#' + id).value = ''; }); loadHist(); };\n      if ($('#vst').checked) run('crmUpdateLead', phone, { status: 'Đã xem dự án' }).then(function () { l.status = 'Đã xem dự án'; $('#st').value = 'Đã xem dự án'; done(); }).catch(fail); else done();\n    }).catch(fail);\n  };\n  if ($('#zcBtn')) $('#zcBtn').onclick = function () { zaloChat(phone); };\n  if ($('#zcBtn2')) $('#zcBtn2').onclick = function () { zaloChat(phone); };\n  if ($('#aiBtn')) $('#aiBtn').onclick = function () {\n    var out = $('#aiOut'); out.hidden = false; out.innerHTML = '<span class=\"mut\">Quân sư đang phân tích…</span> <button class=\"btn sm\" id=\"aiX\">Đóng</button>'; $('#aiX').onclick = function () { out.hidden = true; }; $('#aiBtn').disabled = true;\n    var q = 'Phân tích khách hàng này và trả lời đúng 8 mục, có đánh số: 1) Tóm tắt khách hàng. 2) Mức độ tiềm năng và căn cứ. 3) Thông tin còn thiếu cần hỏi. 4) Vướng mắc chính. 5) Dự án hoặc sản phẩm phù hợp và lý do. 6) Phương án tư vấn tiếp theo. 7) Một tin nhắn mẫu để chăm sóc, viết sẵn nội dung. 8) Công việc đề xuất kèm thời gian thực hiện. Chỉ dùng dữ liệu đã cho. Không bịa giá bán, chính sách, ưu đãi, pháp lý hay tiến độ thanh toán. Thiếu dữ liệu thì nói rõ cần bổ sung gì.';\n    run('crmAsk', q, phone).then(function (a) {\n      $('#aiBtn').disabled = false;\n      out.innerHTML = '<div class=\"row\"><b>Quân sư phân tích</b> <span class=\"tag\">AI đề xuất, bạn kiểm tra trước khi dùng</span><span class=\"sp\"></span><butt