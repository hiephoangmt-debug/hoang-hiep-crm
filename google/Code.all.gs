\">' + esc(x.note || '') + '</textarea><div class=\"row\" style=\"margin-top:8px\"><button class=\"btn p\" id=\"cmok\">Lưu</button><button class=\"btn\" id=\"cmx\">Huỷ</button></div>';\n  $('#dlg').showModal();\n  $('#cmx').onclick = function () { $('#dlg').close(); };\n  var n3 = !!x.net, n11 = !!x.now;\n  $('#cm3').oninput = function () { n3 = true; }; $('#cm11').oninput = function () { n11 = true; if (!n3) $('#cm3').value = this.value; };\n  var auto = function () { var t = parseFloat(String($('#cm9').value).replace(/\\./g, '').replace(',', '.')), p = parseFloat(String($('#cm10').value).replace(/\\./g, '').replace(',', '.')) || 0; if (!n11 && t) { $('#cm11').value = Math.max(0, t - p); if (!n3) $('#cm3').value = $('#cm11').value; } };\n  $('#cm9').oninput = auto; $('#cm10').oninput = auto;\n  $('#cmok').onclick = function () {\n    if (!$('#cm1').value) { toast('Hãy chọn tháng'); return; }\n    var f = { row: x.row || 0, month: $('#cm1').value, type: $('#cm2').value, net: $('#cm3').value, unit: $('#cm4').value, project: $('#cm5').value, phone: $('#cm6').value, price: $('#cm7').value, rate: $('#cm8').value, total: $('#cm9').value, prev: $('#cm10').value, now: $('#cm11').value, taxPaid: $('#cm12').value, taxDue: $('#cm13').value, note: $('#cm14').value };\n    $('#cmok').disabled = true;\n    run('crmCommSave', f).then(function () { toast('Đã lưu'); $('#dlg').close(); CM.month = f.month.slice(0, 4) === CM.year ? CM.month : ''; commLoad(); }).catch(function (e) { $('#cmok').disabled = false; fail(e); });\n  };\n}\n// Dán đoạn chat Zalo của khách để quân sư AI tóm tắt, rút nhu cầu, vướng mắc và gợi ý bước kế. Zalo cá nhân không có cách tự động lấy lịch sử chat.\nfunction zaloChat(phone) {\n  var l = D.leads.filter(function (x) { return x.phone === phone; })[0]; if (!l) return; var img = '';\n  $('#dlgBody').innerHTML = '<h2 style=\"margin:0\">Chụp Zalo gửi lên: ' + esc(l.name || l.phone) + '</h2><p class=\"small mut\">Trên Zalo, bôi đen đoạn chat rồi Copy và dán vào ô dưới, hoặc chụp màn hình cuộc trò chuyện và chọn ảnh. Chỉ nội dung bạn đưa vào mới được gửi cho quân sư AI.</p>' +\n    '<textarea id=\"zct\" rows=\"7\" placeholder=\"Dán đoạn chat vào đây (tối đa khoảng 6.000 ký tự, nên dán phần gần nhất)\"></textarea><div class=\"row\" style=\"margin-top:8px\"><label class=\"btn\" style=\"cursor:pointer\">Chọn ảnh chụp chat<input id=\"zci\" type=\"file\" accept=\"image/*\" hidden></label><span class=\"small mut\" id=\"zcn\"></span><button class=\"btn p\" id=\"zcgo\">Phân tích</button><button class=\"btn\" id=\"zcx\">Đóng</button></div><div id=\"zcr\"></div>';\n  $('#dlg').showModal(); $('#zcx').onclick = function () { $('#dlg').close(); };\n  $('#zci').onchange = function () { var f = this.files && this.files[0]; if (!f) return; snImage(f, function (d) { img = d; $('#zcn').textContent = 'Đã chọn ảnh'; }); };\n  $('#zcgo').onclick = function () {\n    var t = $('#zct').value.trim(); if (!t && !img) { toast('Hãy dán đoạn chat hoặc chọn ảnh'); return; }\n    $('#zcgo').disabled = true; $('#zcr').innerHTML = '<div class=\"mut\" style=\"margin-top:8px\">Quân sư đang đọc đoạn chat…</div>';\n    run('crmScanChat', phone, t.slice(-6000), img, 'image/jpeg').then(function (r) {\n      $('#zcgo').disabled = false;\n      var row = function (h, v) { return v ? '<div style=\"margin-top:6px\"><b>' + h + '</b><div style=\"white-space:pre-wrap\">' + esc(v) + '</div></div>' : ''; };\n      var hm = { 'Nóng': 'Nóng', 'Ấm': 'Ấm', 'Nguội': 'Lạnh' };\n      $('#zcr').innerHTML = '<div class=\"card\" style=\"margin-top:8px\">' + row('Tóm tắt', r.summary) + row('Khách phản hồi gần nhất', r.reply) + row('Nhu cầu, ngân sách', r.need) + row('Vướng mắc', r.obstacle) + row('Độ nóng', r.heat + (r.reason ? ': ' + r.reason : '')) + row('Bước tiếp theo', r.next) + row('Hẹn liên hệ lại', r.followUp ? fdmy(r.followUp) : '') + row('Tin nhắn mẫu', r.message) + '</div>' +\n        '<label class=\"small\" style=\"display:block;margin:6px 0\"><input type=\"checkbox\"