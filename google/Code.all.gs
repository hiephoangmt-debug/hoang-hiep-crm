rn dayOf(l.at); }, R.from, R.to, '#F28C28', 'Khách phát sinh theo ngày') +\n    '<div class=\"card tw\"><table class=\"stt\"><tr><th>Nhóm</th><th>Số khách</th><th>Tỉ lệ</th><th>Chưa liên hệ</th><th>Đã liên hệ</th><th>Đã đi xem</th><th>Khách nóng</th><th>Đã chốt</th><th>Tỉ lệ chốt</th><th>Doanh thu</th></tr>' +\n    (rows.map(function (g, i) { return '<tr class=\"drill\" data-g=\"' + i + '\"><td><b>' + esc(g.k) + '</b></td><td>' + g.n + '</td><td>' + pct(g.n, tot.n) + '</td><td>' + (g.unc ? '<span class=\"tag red\">' + g.unc + '</span>' : 0) + '</td><td>' + g.contacted + '</td><td>' + g.viewed + '</td><td>' + g.hot + '</td><td>' + g.won + '</td><td>' + pct(g.won, g.n) + '</td><td>' + money(g.rev) + '</td></tr>'; }).join('') || '<tr><td colspan=\"10\" class=\"mut\">Chưa có khách trong khoảng ngày này.</td></tr>') +\n    '</table></div><p class=\"mut small\">Thống kê theo ngày phát sinh khách. Chỉ tính khách bất động sản.</p>';\n  bindRange();\n  $('#dim').onchange = function (e) { F.dim = e.target.value; stats(); };\n  document.querySelectorAll('.drill').forEach(function (r) { r.onclick = function () {\n    var g = rows[r.dataset.g], v = g.k; F.status = 'all'; F.site = ''; F.src = ''; F.prov = ''; F.area = ''; F.proj = ''; F.as = ''; F.q = ''; F.bud = ''; F.df = R.from; F.dt = R.to; F.page = 1;\n    var d = F.dim;\n    if (d === 'area' && v !== 'Chưa rõ') F.prov = v; else if (d === 'district' && v !== 'Chưa rõ') F.area = v; else if (d === 'project') F.proj = v === 'Chưa có dự án' ? '' : v; else if (d === 'site') F.site = v; else if (d === 'source') F.src = v;\n    else if (d === 'sale') F.as = v === 'Chưa giao' ? '__none' : v; else if (d === 'status') F.status = v; else if (d === 'purpose' || d === 'budget') F.q = d === 'purpose' ? v : '';\n    tab = 'leads'; document.querySelectorAll('#nav button').forEach(function (x) { x.classList.toggle('on', x.dataset.t === 'leads'); }); render(); window.scrollTo(0, 0); }; });\n}\n\nfunction sites() {\n  $('#main').innerHTML = D.