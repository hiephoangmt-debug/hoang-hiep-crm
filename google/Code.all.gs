ung dán được gửi cho quân sư AI đọc.</p>' +\n    '<textarea id=\"zb1\" rows=\"8\" placeholder=\"Dán các cuộc chat vào đây (tối đa khoảng 20.000 ký tự)\"></textarea><div class=\"row\" style=\"margin-top:8px\"><label class=\"btn\" style=\"cursor:pointer\">Chọn ảnh<input id=\"zb2\" type=\"file\" accept=\"image/*\" hidden></label><span class=\"small mut\" id=\"zb3\"></span><button class=\"btn p\" id=\"zbgo\">Quét</button><button class=\"btn\" id=\"zbx\">Đóng</button></div><div id=\"zbr\"></div>';\n  $('#dlg').showModal(); $('#zbx').onclick = function () { $('#dlg').close(); };\n  $('#zb2').onchange = function () { var f = this.files && this.files[0]; if (!f) return; snImage(f, function (d) { img = d; $('#zb3').textContent = 'Đã chọn ảnh'; }); };\n  var norm = function (n) { return String(n || '').toLowerCase().replace(/^(anh|chị|chi|cô|co|chú|chu|bác|bac|ông|ong|bà|ba)\\s+/, '').replace(/\\s+/g, ' ').trim(); };\n  var match = function (c) {\n    if (c.phone) { var a = D.leads.filter(function (l) { return l.phone === c.phone || l.phone2 === c.phone; })[0]; return a || null; }\n    var n = norm(c.name); if (!n) return null;\n    var m = D.leads.filter(function (l) { return norm(l.name) === n; }); return m.length === 1 ? m[0] : null;\n  };\n  $('#zbgo').onclick = function () {\n    var t = $('#zb1').value.trim(); if (!t && !img) { toast('Hãy dán nội dung hoặc chọn ảnh'); return; }\n    $('#zbgo').disabled = true; $('#zbr').innerHTML = '<div class=\"mut\" style=\"margin-top:8px\">Quân sư đang đọc…</div>';\n    run('crmScanZalo', t.slice(0, 20000), img, 'image/jpeg').then(function (r) {\n      $('#zbgo').disabled = false; res = r.conversations.map(function (c) { return { c: c, l: match(c) }; });\n      var ok = res.filter(function (x) { return x.l; });\n      $('#zbr').innerHTML = '<div class=\"small\" style=\"margin:8px 0\"><b>' + ok.length + '</b> người khớp khách trong CRM, <b>' + (res.length - ok.length) + '</b> bỏ qua vì không có trong CRM hoặc trùng tên chưa rõ là ai.</div>' +\n        res.map(function (x, i) {\n          var c = x.c; return '<div class=\"card\" style=\"margin:6px 0;' + (x.l ? '' : 'opacity:.55') + '\"><label class=\"row\" style=\"margin:0\"><input type=\"checkbox\" data-zi=\"' + i + '\"' + (x.l ? ' checked' : ' disabled') + '><b>' + esc(c.name || c.phone) + '</b>' + (x.l ? '<span class=\"tag grn\">Khớp: ' + esc(x.l.name || x.l.phone) + ' · ' + esc(x.l.phone) + '</span>' : '<span class=\"tag\">Bỏ qua</span>') + '</label>' +\n            '<div class=\"small\">' + [c.kind === 'contact' ? 'Có trong danh bạ Zalo' + (c.label ? ': ' + c.label : '') : '', c.summary, c.need && 'Nhu cầu: ' + c.need, c.obstacle && 'Vướng mắc: ' + c.obstacle, c.heat && 'Mức độ: ' + c.heat, c.next && 'Bước tiếp: ' + c.next].filter(Boolean).map(esc).join('<br>') + '</div></div>';\n        }).join('') + (ok.length ? '<div class=\"row\"><button class=\"btn p\" id=\"zbsv\">Lưu vào hồ sơ khách đã chọn</button></div>' : '');\n      if ($('#zbsv')) $('#zbsv').onclick = function () {\n        var pick = [].slice.call(document.querySelectorAll('[data-zi]:checked')).map(function (b) { return res[+b.dataset.zi]; });\n        if (!pick.length) { toast('Chưa chọn ai'); return; } this.disabled = true; var done = 0;\n        pick.reduce(function (p, x) {\n          return p.then(function () { var c = x.c;\n            if (c.kind === 'contact') { var job = x.l.zalo === 'Đã kết nối' ? Promise.resolve() : run('crmUpdateLead', x.l.phone, { zalo: 'Đã kết nối' }); return job.then(function () { return c.label ? run('crmAddLog', x.l.phone, { type: 'Ghi chú', content: 'Danh bạ Zalo ghi chú: ' + c.label }) : null; }).then(function () { done++; }); }\n            return run('crmAddLog', x.l.phone, { type: 'Ghi chú', content: ('Chat Zalo: ' + [c.summary, c.need && 'Nhu cầu: ' + c.need, c.obstacle && 'Vướng mắc: ' + c.obstacle, c.heat && 'Mức độ: ' + c.heat].filter(Boolean).join('. ')).slice(0, 1400), nextAction: c.next || '' }).then(function () { done++; }); });\n    