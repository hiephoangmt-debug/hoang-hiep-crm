irst) + ' → ' + fdmy(x.last) : '-', days = x.first ? Math.round((new Date(x.last) - new Date(x.first)) / 864e5) + 1 : 0;\n      return '<tr><td><b>' + esc(x.name) + '</b><div class=\"mut small\">' + esc(x.utm) + (x.platform ? ' · ' + esc(x.platform) : '') + (x.declared ? '' : ' · <span class=\"tag amb\">chưa khai báo ở tab Chiến dịch</span>') + '</div></td><td class=\"small nw\">' + run + '<div class=\"mut\">' + days + ' ngày · chạy ' + x.activeDays + '/' + P.days + ' ngày</div></td><td>' + money(x.cost) + '</td><td>' + chg(x.cost, x.costPrev) + '</td><td>' + x.imp.toLocaleString('vi-VN') + '</td><td>' + x.clk + '</td><td>' + pct(x.clk, x.imp) + '</td><td>' + (x.clk ? vnd(x.cost / x.clk) : '-') + '</td><td>' + x.visitors + '</td><td>' + (x.zalo + x.phone) + '</td><td><b>' + x.leads + '</b></td><td>' + chg(x.leads, x.leadsPrev) + '</td><td>' + (x.leads && x.cost ? vnd(x.cost / x.leads) : '-') + '</td><td>' + x.closed + '</td><td>' + money(x.revenue) + '</td><td>' + (x.cost && x.revenue ? (Math.round(x.revenue / x.cost * 10) / 10) + 'x' : '-') + '</td></tr>';\n    }).join('');\n    var advice = L.map(function (x) {\n      var ad = advise(x, { avgCpl: avgCpl }), worst = ad.some(function (a) { return a.lv === 'bad'; }) ? 'bad' : ad.some(function (a) { return a.lv === 'warn'; }) ? 'warn' : ad.some(function (a) { return a.lv === 'good'; }) ? 'good' : 'info';\n      var chip = { bad: ['red', 'Cần xử lý'], warn: ['amb', 'Cần xem lại'], good: ['grn', 'Tốt'], info: ['', 'Theo dõi'] }[worst];\n      return '<div class=\"card\"><div class=\"row\" style=\"margin:0\"><b>' + esc(x.name) + '</b><span class=\"tag ' + chip[0] + '\">' + chip[1] + '</span><span class=\"sp\"></span><span class=\"mut small\">Chi ' + money(x.cost) + ' · ' + x.leads + ' khách' + (x.leads && x.cost ? ' · ' + vnd(x.cost / x.leads) + '/khách' : '') + '</span></div>' +\n        ad.map(function (a) { return '<div class=\"adv ' + a.lv + '\"><div>' + esc(a.t) + '</div>' + (a.steps.length ? '<details><summary>Cách