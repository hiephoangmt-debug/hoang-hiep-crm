# Đổi tên file này thành .env rồi điền thông tin

# Token bot Zalo – tạo ở https://bot.zaloplatforms.com
ZALO_BOT_TOKEN=

# API key Claude – tạo ở https://console.anthropic.com
ANTHROPIC_API_KEY=

# chat_id Zalo của anh/chị (nhắn /id cho bot để biết) – nhận báo khách nóng, lịch hẹn, dùng lệnh
ADMIN_CHAT_ID=

# Người bot KHÔNG trả lời (đồng nghiệp, người nhà...) – các chat_id cách nhau dấu phẩy
# (hoặc dùng lệnh /rieng <chat_id> ngay trên Zalo)
IGNORE_CHAT_IDS=

# Khung chat LadiPage: đặt cổng (ví dụ 8080) để bật, 0 = tắt
WEB_PORT=0
# Tên miền LadiPage được phép dùng khung chat, cách nhau dấu phẩy
ALLOWED_ORIGIN=*

# Google Sheet (tùy chọn) – link Web App từ file google_sheet.gs
SHEET_WEBHOOK_URL=
SHEET_SECRET=doi-thanh-chuoi-bi-mat

# Bảng hàng trên Google Sheet (tùy chọn) – dán link, nhiều link cách nhau dấu phẩy
# (hoặc nhắn bot: /banghang <link>). Sheet phải chia sẻ "Bất kỳ ai có đường liên kết đều xem được"
BANG_HANG_URLS=

# Chăm sóc khách im lặng: 1 = bật, 0 = tắt (hoặc nhắn bot /chamsoc tat)
FOLLOWUP=1
# Nhắn lại sau bao nhiêu ngày khách im lặng
FOLLOWUP_DAYS=1,3,7
# Báo cáo buổi sáng (8h–11h): lịch hẹn hôm nay + khách nóng nên gọi
MORNING_BRIEF=1

# Tùy chọn nâng cao
CLAUDE_MODEL=claude-sonnet-5-5
MAX_HISTORY=30
HUMAN_PAUSE_MINUTES=30
CAMPAIGN_MIN_SCORE=7
CAMPAIGN_DELAY_SECONDS=8
WEB_DAILY_LIMIT=60
WEB_IP_DAILY_LIMIT=200
FORWARD_IGNORED=1
# Số ký tự tối đa của lời chào kết bạn Zalo (ô lời chào bị cắt thì giảm số này)
FRIEND_MAX_CHARS=70
