# Sao chép thành file .env rồi sửa
PORT=3000
# Mật khẩu đăng nhập CRM (bắt buộc đặt khi chạy thật)
ADMIN_PASSWORD=doi-mat-khau-nay
# Chuỗi ngẫu nhiên dài để ký phiên đăng nhập
SESSION_SECRET=
# Key webhook (để trống: tự sinh, xem trong trang Cài đặt)
WEBHOOK_KEY=
# Địa chỉ public của CRM, VD: https://crm.hiephoangmt.com
PUBLIC_URL=
# Nơi lưu dữ liệu
DB_PATH=./data/crm.db

# (Tuỳ chọn) Telegram báo lead mới: tạo bot qua @BotFather, lấy chat id qua @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# (Tuỳ chọn) Gợi ý câu nói bằng AI – cần chạy "npm install"
ANTHROPIC_API_KEY=
