# Sao chép file này thành ".env" rồi điền thông tin của bạn.
# File .env KHÔNG được đưa lên GitHub (đã nằm trong .gitignore).

# Mật khẩu đăng nhập trang tư vấn viên /agent.html
AGENT_PASSWORD=dat-mat-khau-o-day

# Số hotline và Zalo hiển thị trên khung chat
HOTLINE=0904 567 009
ZALO=0904567009

# Token bot Telegram (lấy từ @BotFather)
TELEGRAM_BOT_TOKEN=

# Chat ID nhận thông báo (nhắn bot để lấy). Nhiều người: cách nhau dấu phẩy
TELEGRAM_CHAT_ID=

# Địa chỉ website chat sau khi đưa lên mạng, ví dụ https://chat.tenmien.vn
PUBLIC_URL=

# Màu giao diện (mã hex). Mặc định: xanh navy và cam
PRIMARY_COLOR=#0b2a5b
ACCENT_COLOR=#f47c20
